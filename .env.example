# ============================================================================
# Assignment FM — Environment Configuration
# ============================================================================
# Copy this file to .env for local overrides.
# No secrets or Replit tokens are required for Phase 1.

# Node / Express Server Port (default: 5000)
PORT=5000

# Server Host binding (default: 0.0.0.0)
HOST=0.0.0.0

# Node Environment ('development' | 'production')
NODE_ENV=development

# Vite Frontend Dev Server Port (default: 5173)
VITE_PORT=5173

# YouTube Data API v3 Key (Server-side only — NEVER expose to client/browser)
# Get a key from Google Cloud Console with YouTube Data API v3 enabled:
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=AIzaSyAiyPHzA0WssJoNNkbl3I3VckVRGwEIdyA
